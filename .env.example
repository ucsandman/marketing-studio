# Path to blender.exe if Blender is not on PATH (phase 3 feeder)
BLENDER_PATH=C:/Program Files/Blender Foundation/Blender X.Y/blender.exe
# ElevenLabs (audio feeder: voiceover + music)
ELEVENLABS_API_KEY=sk_your_key_here
# Optional; defaults to the Rachel premade voice
ELEVENLABS_VOICE_ID=
# Optional per-brand override, wins over the global one: ELEVENLABS_VOICE_ID_<BRAND>
# (brand id uppercased, dashes -> underscores), e.g. ELEVENLABS_VOICE_ID_TENWORDS=
ELEVENLABS_VOICE_ID_<BRAND>=
# X API v2 bearer token (results feedback loop: scripts/fetch-results.mjs);
# missing token = exit 2, X posts marked unavailable in results.json
X_BEARER_TOKEN=
# Bluesky publishing (scripts/publish-bluesky.mjs, Mission Control's Publish to
# Bluesky button). An APP password from Settings > App passwords, never the account
# password. Missing = exit 2, nothing published. Metrics need no token.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
