# launch/ (marketing-studio) social provider credentials
#
# Copy to .env and fill in only the providers you intend to post to via API.
# Missing keys are fine: `launch doctor` reports those providers as "blocked"
# and `launch post --all` skips them.
#
# NOTE: DashClaw-covered infrastructure credentials (Namecheap domain, Vercel,
# Stripe, Resend, Twilio, DNS) are NOT configured here — they live with the
# DashClaw MCP server. The CLI never holds those credentials.

# --- X (Twitter) — OAuth 1.0a user context, from developer.x.com app keys ---
X_API_KEY=your-x-api-key
# X app API secret (a.k.a. consumer secret)
X_API_SECRET=your-x-api-secret
# Access token for the posting account (generated under the app's Keys & Tokens)
X_ACCESS_TOKEN=your-x-access-token
# Access token secret paired with X_ACCESS_TOKEN
X_ACCESS_SECRET=your-x-access-secret

# --- Facebook — Graph API page posting ---
# Facebook app ID from developers.facebook.com
FB_APP_ID=your-fb-app-id
# Facebook app secret
FB_APP_SECRET=your-fb-app-secret
# Numeric ID of the Facebook Page to post to
FB_PAGE_ID=your-fb-page-id
# PAGE access token (not a user token) with pages_manage_posts
FB_PAGE_ACCESS_TOKEN=your-fb-page-access-token

# --- LinkedIn — member posting via /rest/posts ---
# LinkedIn app client ID from developer.linkedin.com
LINKEDIN_CLIENT_ID=your-linkedin-client-id
# LinkedIn app client secret
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
# 3-legged member access token (expires after 60 days — doctor warns near expiry)
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token
# URN of the posting member, e.g. urn:li:person:abc123
LINKEDIN_PERSON_URN=urn:li:person:your-id
# Pinned LinkedIn-Version header, e.g. 202506
LINKEDIN_VERSION=202506

# --- Reddit — script app, password grant (1h tokens, auto-refetched) ---
# Script-app client ID from reddit.com/prefs/apps
REDDIT_CLIENT_ID=your-reddit-client-id
# Script-app client secret
REDDIT_CLIENT_SECRET=your-reddit-client-secret
# Reddit account username that owns the script app
REDDIT_USERNAME=your-reddit-username
# Reddit account password (script apps use the password grant)
REDDIT_PASSWORD=your-reddit-password
# Descriptive user agent, e.g. "marketing-studio-launch/0.1 by u/yourname" (required by Reddit)
REDDIT_USER_AGENT=marketing-studio-launch/0.1 by u/your-username

# --- Google Search Console — service account ---
# Absolute path to the service-account JSON key file (file itself stays out of git)
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
# GSC property URL, e.g. sc-domain:example.com or https://example.com/
GSC_SITE_URL=sc-domain:example.com

# --- Bing Webmaster Tools — JSON API (sitemap + URL submission) ---
# Account-wide key: bing.com/webmasters > Settings (gear) > API Access > API Key > Generate
BING_WEBMASTER_API_KEY=your-bing-webmaster-api-key
# Site to submit for, as an http(s) URL. Optional — falls back to GSC_SITE_URL
# (an sc-domain: property is rewritten to https://), then to the launch config productUrl.
BING_SITE_URL=https://example.com
# Account-wide ownership code from Bing's "Verify ownership" > HTML Meta Tag
# (<meta name="msvalidate.01" content="...">). Optional; when set, `launch post` verifies the site.
BING_VERIFICATION_CODE=your-bing-verification-code

# --- Product Hunt — read-only stats polling (posting is assisted/manual) ---
# Developer token from producthunt.com/v2/oauth/applications
PRODUCTHUNT_DEV_TOKEN=your-producthunt-dev-token
# ISO date the LinkedIn token was generated — enables 60-day expiry warnings in `launch doctor`
LINKEDIN_TOKEN_ISSUED_AT=2026-06-12

# --- Bluesky — open AT Protocol write API (post + video upload) ---
# Account handle, e.g. brand.bsky.social
BLUESKY_HANDLE=your-handle.bsky.social
# App password from bsky.app > Settings > App passwords (NEVER the account password)
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- YouTube — Data API v3 resumable upload (OAuth 2.0 installed app) ---
# Desktop-app OAuth client id from Google Cloud Console (YouTube Data API v3 enabled)
YOUTUBE_CLIENT_ID=your-youtube-client-id
# OAuth client secret paired with YOUTUBE_CLIENT_ID
YOUTUBE_CLIENT_SECRET=your-youtube-client-secret
# Refresh token from the one-time consent flow (scope youtube.upload)
YOUTUBE_REFRESH_TOKEN=your-youtube-refresh-token
# Visibility for new uploads: private (default) | unlisted | public
YOUTUBE_PRIVACY=private
